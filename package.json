        "@navikt/next-api-proxy": "^5.0.5",
        "@navikt/next-logger": "^5.0.0",
        "@navikt/oasis": "^4.1.4",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@types/smoothscroll-polyfill": "^0.3.4",
        "@unleash/nextjs": "^1.6.7",
        "classnames": "^2.5.1",
        "cookie": "^2.0.1",
        "date-fns": "^4.4.0",
        "html-react-parser": "^6.1.4",
        "jose": "^6.2.6",
        "next-logger": "^5.0.2",
        "nextleton": "^0.6.1",
        "node-cache": "^5.1.2",
        "node-fetch": "^3.3.2",
        "pino-pretty": "^13.1.3",
