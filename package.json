    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@eslint/eslintrc": "^3.3.1",
        "@navikt/tsm-prettier": "^2.0.1",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/classnames": "^2.3.4",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.12.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react": "^4.7.0",
        "axe-core": "^4.12.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.0.10",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "next": "^16.2.10",
        "postcss": "^8.5.19",
        "prettier": "^3.8.4",
        "start-server-and-test": "^3.0.11",
        "tailwindcss": "^4.1.16",
        "ts-loader": "^9.5.7",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "dev": "NEXT_PUBLIC_MOCK_BACKEND=true next dev -p 3000  | pino-pretty",
        "local": "NEXT_PUBLIC_LOCAL_BACKEND=true next dev -p 3000 | pino-pretty",
        "dev-ingen-dekorator": "NEXT_PUBLIC_MOCK_BACKEND=true NO_DECORATOR=true npm run dev  | pino-pretty",
        "start": "next start -p 3000",
        "start-ingen-dekorator": "NO_DECORATOR=true npm start",
        "build": "next build",
        "test": "NEXT_PUBLIC_MOCK_BACKEND=true vitest",
        "test:ci": "npm run test:ci:tidssoner && vitest --run",
        "test:ci:tidssoner:utc": "TZ=UTC vitest --run src/utils/dato-utils.test.ts",
        "test:ci:tidssoner:oslo": "TZ=Europe/Oslo vitest --run src/utils/dato-utils.test.ts",
        "test:ci:tidssoner:new-york": "TZ=America/New_York vitest --run src/utils/dato-utils.test.ts",
        "test:ci:tidssoner": "npm run test:ci:tidssoner:oslo && npm run test:ci:tidssoner:new-york && npm run test:ci:tidssoner:utc",
        "play": "PLAYWRIGHT_ALL=true npx playwright test --ui",
        "play-headless": "PLAYWRIGHT_HTML_OPEN=never npx playwright test",
        "play-build": "export PLAYWRIGHT_ALL=true BUILD=true; npm run build && npx playwright test --ui",
        "play-headless-build": "PLAYWRIGHT_HTML_OPEN=never export BUILD=true; npm run build && npx playwright test",
        "prettier:write": "prettier --write .",
        "prettier:check": "prettier --check .",
        "tsc": "tsc",
        "lint": "eslint src playwright",
        "lint:fix": "eslint src playwright --fix",
        "format": "npm run prettier:write && npm run lint:fix"
    },
    "prettier": "@navikt/tsm-prettier",
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.62.2"
    }
}
